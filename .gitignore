# ----------------------------
# Core Node / JavaScript
# ----------------------------
backend/node_modules/
node_modules/
**/node_modules/

# Dependency diagnostic logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
# Environment / Secrets
# ----------------------------
# Ignore all real env files, keep the examples
.env
*.env
!.env.example
!**/.env.example

# Explicit common locations (defensive if structure shifts)
backend/.env
frontend/.env
v4/backend/.env
v4/frontend/.env

# ----------------------------
# Build & Output Artifacts
# ----------------------------
dist/
**/dist/
build/
coverage/
.nyc_output/

# Vite / Framework caches
.vite/
vite.config.timestamp-*

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
logs-*

# ----------------------------
# OS / Editor / Tooling
# ----------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ----------------------------
# Temporary / Misc
# ----------------------------
.tmp/
temp/
.cache/
*.pid
*.seed
*.tgz

# ----------------------------
# TypeScript (if added later)
# ----------------------------
*.tsbuildinfo

# ----------------------------
# Local data snapshots (if you later dump storage)
# ----------------------------
data/
*.sqlite
*.db
*.db-journal

# ----------------------------
# Prevent accidental committing of test artifacts
# ----------------------------
test-output/
playwright-report/
