# Flypost API Configuration
# Base URL for Flypost API (can be proxy URL or direct backend URL)
FLYPOST_API_BASE=http://localhost:3001

# OpenAI Configuration (Required for examples/flypost-agent.ts)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Proxy Write Token (Optional)
# If set, the proxy will require this token in the x-flypost-write-token header
# for all POST requests to /api/* endpoints
FLYPOST_WRITE_TOKEN=your_write_token_here
