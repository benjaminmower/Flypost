# Flypost API Configuration
# Base URL for Flypost API (can be proxy URL or direct backend URL)
FLYPOST_API_BASE=http://localhost:3001

# OpenAI Configuration (Required for examples/flypost-agent.ts)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Web Concierge Feature (Optional)
# Enable the Web Concierge chat feature (default: false)
ENABLE_CONCIERGE=false

# Allowed origins for Web Concierge widget (comma-separated)
# Add your Webflow site domain here
CONCIERGE_ALLOWED_ORIGINS=https://your-webflow-site.webflow.io,https://your-custom-domain.com

# Proxy Write Token (Optional)
# If set, the proxy will require this token in the x-flypost-write-token header
# for all POST requests to /api/* endpoints
# Generate a secure token: openssl rand -hex 32
FLYPOST_WRITE_TOKEN=a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890

# Brokerage-Specific Write Tokens (Optional)
# These tokens allow specific brokerages to publish events to their tenancy
# Vista SIR brokerage token
VISTA_WRITE_TOKEN=vista_sir_token_here

# BHHS Utah brokerage token
BHHS_UTAH_WRITE_TOKEN=bhhs_utah_token_here

# Compass brokerage token
COMPASS_WRITE_TOKEN=compass_token_here
