{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goflypost.com/schemas/flypost-discovery-v1.schema.json",
  "title": "Flypost Discovery v1",
  "description": "Success response envelope for Flypost Discovery (protocol flypost-discovery, version v1). Non-2xx error responses are out of scope for this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "success", "events", "meta"],
  "properties": {
    "protocol": { "type": "string", "const": "flypost-discovery" },
    "version": { "type": "string", "const": "v1" },
    "success": { "type": "boolean", "const": true },
    "events": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/discoveryEvent" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of events returned. Must equal events.length; enforce in server tests/runtime."
        }
      }
    }
  },
  "$defs": {
    "discoveryEvent": {
      "title": "Discovery Event",
      "description": "A single discovered event.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "dataHash", "what", "where", "when", "externalListingUrl", "shareUrl"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },

        "dataHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of canonical payload containing only {what.type, where.latitude, where.longitude, when.start, when.end}. Excludes optional/human fields (e.g., what.label, where.address, externalListingUrl, source). Canonicalization and normalization (UTC handling, numeric rounding) are protocol-defined; recommend RFC 8785 JCS over UTF-8 bytes."
        },

        "what": {
          "title": "What",
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "open_house",
                "garage_sale",
                "estate_sale",
                "moving_sale",
                "yard_sale",
                "apartment",
                "job_posting",
                "live_event",
                "community_alert",
                "happy_hour",
                "missing_pet",
                "other"
              ]
            },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },

        "where": {
          "title": "Where",
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "address": { "type": "string", "maxLength": 200 }
          }
        },

        "when": {
          "title": "When",
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" },
            "timezone": { "type": "string" }
          }
        },

        "externalListingUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },

        "source": {
          "description": "Optional provenance for the discovery event.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["mls", "brokerage_roster", "manual", "third_party"]
            },
            "url": {
              "oneOf": [
                { "type": "string", "format": "uri" },
                { "type": "null" }
              ]
            }
          }
        },

        "shareUrl": {
          "type": "string",
          "format": "uri"
        },

        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "Optional public HTTPS image URL for image-first consumer surfaces."
        },

        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["occurrenceId", "startDate", "endDate"],
            "properties": {
              "occurrenceId": { "type": "string" },
              "startDate": { "type": "string", "format": "date-time" },
              "endDate": { "type": "string", "format": "date-time" },
              "label": { "type": "string" },
              "local": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "date": { "type": "string" },
                  "startTime": { "type": "string" },
                  "endTime": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
