# Flypost v4 Backend Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# OpenAI Configuration (Required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default user context
DEFAULT_LOCATION=Springfield, IL
DEFAULT_TIMEZONE=America/Chicago

# Firestore Configuration (Optional)
# If not set, the backend will use in-memory storage only
# For production: set GOOGLE_CLOUD_PROJECT to your GCP project ID
# The backend will use Application Default Credentials (ADC)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# For local development with Firestore emulator:
# Uncomment and set to run against local Firestore emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Web Concierge Configuration (Optional)
# Enable the Web Concierge chat widget feature
ENABLE_CONCIERGE=true

# Allowed origins for Web Concierge CORS (comma-separated)
# Add your Webflow domains here for production
CONCIERGE_ALLOWED_ORIGINS=https://ask.goflypost.com,https://webflow.io